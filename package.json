{
  "name": "workfloor",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "deploy:web": "expo export --platform web && eas deploy --prod",
    "legal:site": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-legal-site.mjs",
    "db:push": "supabase db push",
    "functions:deploy": "supabase functions deploy",
    "db:backup": "supabase db dump --linked --data-only -f supabase/backups/data.sql",
    "db:demo:preflight": "supabase db query --linked -f supabase/preflight/20260915000200_demo_data.sql",
    "db:demo:seed": "supabase db query --linked -f supabase/demo/20260915000200_demo_data.sql",
    "db:demo:remove": "supabase db query --linked -f supabase/rollbacks/20260915000200_demo_data.sql",
    "db:purge:preflight": "supabase db query --linked -f supabase/preflight/20260915000300_purge_all_data.sql",
    "db:purge": "supabase db query --linked -f supabase/maintenance/20260915000300_purge_all_data.sql",
    "db:sector-photos:preflight": "supabase db query --linked -f supabase/preflight/20260916000000_sector_photos.sql",
    "db:restrict-author-columns:preflight": "supabase db query --linked -f supabase/preflight/20260916000100_restrict_author_columns.sql",
    "db:review-trust:preflight": "supabase db query --linked -f supabase/preflight/20260917000000_review_trust.sql",
    "db:company-sites:preflight": "supabase db query --linked -f supabase/preflight/20260917000100_company_sites.sql",
    "db:moderation:preflight": "supabase db query --linked -f supabase/preflight/20260917000200_moderation_console.sql",
    "db:types": "supabase gen types typescript --linked --schema public > types/database.ts",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react": "^10.74.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.23",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.19",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.22",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.14",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-toast-message": "^2.5.2",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "supabase": "^2.117.0",
    "typescript": "~6.0.3"
  }
}
