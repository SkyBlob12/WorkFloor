# Copier ce fichier en `.env` puis remplir les valeurs.
# Toutes les variables EXPO_PUBLIC_* sont embarquées dans l'app : n'y mettre AUCUN secret.

# Supabase > Project Settings > API (URL + clé "publishable" / anon)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# URL publique du site web (redirections des emails d'auth, liens légaux)
EXPO_PUBLIC_SITE_URL=http://localhost:8081

# Cloudflare Turnstile — la clé ci-dessous est la clé de TEST officielle (passe toujours).
EXPO_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Domaine autorisé dans Turnstile, utilisé comme origine du widget dans la WebView native
EXPO_PUBLIC_TURNSTILE_ORIGIN=https://workfloor.fr

# Observabilité (optionnel : laissé vide = désactivé)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
