# Secrets des Edge Functions.
# En local : copier en `supabase/functions/.env`.
# En production : `npx supabase secrets set --env-file supabase/functions/.env`
# (SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont injectées automatiquement par Supabase.)

# OpenAI : modération (endpoint gratuit). Vide = modération IA désactivée.
OPENAI_API_KEY=

# Sel pour hacher les IP (générer une longue chaîne aléatoire, ne jamais la changer ensuite)
IP_HASH_SALT=
